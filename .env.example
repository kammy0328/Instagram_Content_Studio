# 이 프로그램은 외부 API 키를 사용하지 않습니다. 비밀 값은 필요 없습니다.
# 아래는 선택적으로 쓸 수 있는 일반 환경 변수입니다.
# 주의: .env 파일을 자동으로 읽지 않습니다. 셸에서 export(set) 해서 사용하세요. (python-dotenv 미사용)

# FFmpeg / FFprobe 실행 파일 경로 (미지정 시 vendor/ffmpeg -> PATH 순서로 탐색)
ICS_FFMPEG=
ICS_FFPROBE=

# 앱 데이터(프로젝트 DB, ID 사전, 설정) / 캐시(썸네일, 프록시, 프레임 인덱스) 위치 (미지정 시 OS 기본 위치)
ICS_DATA_DIR=
ICS_CACHE_DIR=

# 서버/CI 에서 화면 없이 UI 테스트를 돌릴 때
QT_QPA_PLATFORM=offscreen
